# QuoteMatch Environment Variables

# Mock mode toggle: set to true to test against in-memory mock backend
NEXT_PUBLIC_USE_MOCKS=true

# Supabase Auth Configuration (Backend / Database integration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Configuration (Google Gemini is preferred; OpenAI and Anthropic are also supported)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
